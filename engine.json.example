{
  "providers": {
    "primary": {
      "api_key": "your-primary-api-key-here",
      "base_url": "https://your-primary-base-url/v1",
      "rpm_limit": 300,
      "tpm_limit": 100000,
      "max_concurrent_requests": 3,
      "models": {
        "your-primary-model": {}
      }
    },
    "fallback": {
      "api_key": "your-fallback-api-key-here",
      "base_url": "https://your-fallback-base-url/v1",
      "rpm_limit": 100,
      "tpm_limit": 50000,
      "models": {
        "your-fallback-model": {}
      }
    }
  },
  "primary": "primary/your-primary-model",
  "fallback": [
    "fallback/your-fallback-model"
  ],
  "strip_thinking": true,
  "spawn_timeout": 30.0,
  "max_result_length": 3000,
  "summary_warning_reserve": 2,
  "emergency_summary_enabled": true,
  "emergency_summary_context_messages": 0,
  "log_dir": null,
  "llm_retry_max_attempts": 3,
  "llm_retry_base_delay": 1.0,
  "main_lane_concurrency": 4,
  "subagent_lane_concurrency": 5,
  "pacing_enabled": true,
  "pacing_min_interval_ms": 500.0,
  "key_rotation_enabled": true,
  "fallback_enabled": true,
  "cooldown_initial_ms": 30000.0,
  "cooldown_max_ms": 300000.0,
  "tools": {
    "tool_1": false,
    "tool_2": true
  },
  "file_permissions": {
    "denied_patterns": [
      "**/.env",
      "**/.env.*",
      "**/.git/**",
      "**/credentials*",
      "**/id_rsa*",
      "**/id_ed25519*",
      "**/id_ecdsa*",
      "**/.ssh/**",
      "**/shadow",
      "**/passwd"
    ]
  },
  "workspace": "~/Desktop/Friday"
}
